{
    "name":  "killian2",
    "version":  "2.0.0-alpha.64",
    "description":  "โปรแกรมเขียนนิยาย/บทหนัง — Electron + ProseMirror",
    "main":  "main.js",
    "scripts":  {
                    "start":  "electron .",
                    "build":  "node build.js",
                    "test":  "node test/md.test.js",
                    "test:unit":  "node test/search-engine.test.cjs \u0026\u0026 node test/panel.test.cjs \u0026\u0026 node test/split.test.cjs \u0026\u0026 node test/branch.test.cjs \u0026\u0026 node test/timeline.test.cjs \u0026\u0026 node test/kanban.test.cjs \u0026\u0026 node test/world-story.test.cjs \u0026\u0026 node test/auto-task.test.cjs \u0026\u0026 node test/ai-core.test.cjs \u0026\u0026 node test/ai-features.test.cjs \u0026\u0026 node test/tools.test.cjs \u0026\u0026 node test/relationship.test.cjs \u0026\u0026 node test/sp-format.test.cjs \u0026\u0026 node test/sp-validator.test.cjs \u0026\u0026 node test/sp-view.test.cjs \u0026\u0026 node test/sp-continued.test.cjs \u0026\u0026 node test/sp-reports.test.cjs \u0026\u0026 node test/sp-export.test.cjs \u0026\u0026 node test/smart-terms.test.cjs \u0026\u0026 node test/lang-fonts.test.cjs \u0026\u0026 node test/prose-format.test.cjs \u0026\u0026 node test/alpha58r.test.cjs \u0026\u0026 node test/sp-headers.test.cjs \u0026\u0026 node test/sp-title-pages.test.cjs \u0026\u0026 node test/pdf-generator.test.cjs \u0026\u0026 node test/compile-omit.test.cjs \u0026\u0026 node test/text-case.test.cjs \u0026\u0026 node test/wiki-images.test.cjs \u0026\u0026 node test/scene-meta.test.cjs \u0026\u0026 node test/margin-presets.test.cjs \u0026\u0026 node test/i18n-csv.test.cjs \u0026\u0026 node test/ai-providers.test.cjs \u0026\u0026 node test/album.test.cjs \u0026\u0026 node test/network-layout.test.cjs && node test/ai-tools.test.cjs \u0026\u0026 node test/fountain.test.mjs",
                    "dist":  "node build.js \u0026\u0026 electron-builder --win portable",
                    "dist:dir":  "node build.js \u0026\u0026 electron-builder --win dir",
                    "dist:mac":  "node build.js \u0026\u0026 electron-builder --mac dmg --x64"
                },
    "keywords":  [

                 ],
    "author":  "",
    "license":  "ISC",
    "dependencies":  {
                         "@pdf-lib/fontkit":  "^1.1.1",
                         "fabric":  "^5.3.0",
                         "fuse.js":  "^7.5.0",
                         "jszip":  "^3.10.1",
                         "pdf-lib":  "^1.17.1",
                         "prosemirror-commands":  "^1.7.1",
                         "prosemirror-dropcursor":  "^1.8.3",
                         "prosemirror-gapcursor":  "^1.4.1",
                         "prosemirror-history":  "^1.5.0",
                         "prosemirror-inputrules":  "^1.5.1",
                         "prosemirror-keymap":  "^1.2.3",
                         "prosemirror-model":  "^1.25.11",
                         "prosemirror-schema-list":  "^1.5.1",
                         "prosemirror-state":  "^1.4.4",
                         "prosemirror-transform":  "^1.12.0",
                         "prosemirror-view":  "^1.42.1"
                     },
    "devDependencies":  {
                            "electron":  "^43.1.1",
                            "electron-builder":  "^26.0.12",
                            "esbuild":  "^0.28.1"
                        },
    "productName":  "Killian 2",
    "build":  {
                  "appId":  "com.killian2.app",
                  "productName":  "Killian 2",
                  "directories":  {
"output": "dist"
                                  },
                  "files":  [
                                "main.js",
                                "preload.js",
                                "renderer/**",
                                "languages/**",
                                "node_modules/**",
                                "package.json"
                            ],
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "portable",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ]
                          },
                  "portable":  {
                                   "artifactName":  "Killian2-${version}-portable.exe"
                               },
                  "mac":  {
                              "target":  [
                                             {
                                                 "target":  "dmg",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ],
                              "category":  "public.app-category.productivity",
                              "darkModeSupport":  true,
                              "identity":  null,
                              "hardenedRuntime":  false,
                              "gatekeeperAssess":  false,
                              "artifactName":  "Killian2-${version}-mac-intel.dmg"
                          },
                  "dmg":  {
                              "artifactName":  "Killian2-${version}-mac-intel.dmg",
                              "title":  "Killian 2 ${version}"
                          }
              }
}
