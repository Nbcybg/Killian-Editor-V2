{
  "name": "killian2",
  "version": "2.0.0-alpha.134",
  "description": "โปรแกรมเขียนนิยาย/บทหนัง — Electron + ProseMirror",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "node build.js",
    "i18n": "node tools/i18n-extract.cjs && node test/i18n-keys.test.cjs",
    "i18n:apply": "node tools/i18n-extract.cjs --apply",
    "test": "node test/md.test.js",
    "test:unit": "node tools/run-unit.cjs",
    "dist": "node build.js && electron-builder --win portable",
    "dist:dir": "node build.js && electron-builder --win dir",
    "dist:mac": "node build.js && electron-builder --mac dmg --x64"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fabric": "^5.3.0",
    "fuse.js": "^7.5.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.3",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.1"
  },
  "devDependencies": {
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.4",
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.1"
  },
  "productName": "Killian 2",
  "build": {
    "appId": "com.killian2.app",
    "productName": "Killian 2",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "history-data.cjs",
      "renderer/**",
      "languages/**",
      "node_modules/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Killian2-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Killian2-${version}-mac-intel.dmg"
    },
    "dmg": {
      "artifactName": "Killian2-${version}-mac-intel.dmg",
      "title": "Killian 2 ${version}"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "electron-winstaller@5.4.0": true
  }
}
